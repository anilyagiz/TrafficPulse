# TrafficPulse GCP Environment Variables
# Copy this file to .env.gcp and fill in your values

# ============================================
# GCP Configuration
# ============================================
export PROJECT_ID="your-gcp-project-id"
export REGION="us-central1"
export ENVIRONMENT="production"

# ============================================
# Stellar Network Configuration
# ============================================
# TrafficPulse smart contract address (Stellar testnet or mainnet)
export NEXT_PUBLIC_CONTRACT_ID="CDTUCJ52DABJ3GWL2N5Y5HOEHXA4IA3RUE6DILYFNHWUH4N67EHCWECC"

# Soroban RPC endpoint
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-rpc.stellar.org
export NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Application URL (will be set after deployment)
# Format: https://trafficpulse-REGION-PROJECT_ID.uc.r.appspot.com
export NEXT_PUBLIC_APP_URL=""

# ============================================
# Cloud Run Configuration
# ============================================
export CLOUD_RUN_MIN_INSTANCES=1
export CLOUD_RUN_MAX_INSTANCES=10
export CLOUD_RUN_MEMORY="512Mi"
export CLOUD_RUN_CPU="1000m"
export CLOUD_RUN_CONCURRENCY=80
export CLOUD_RUN_TIMEOUT=300

# ============================================
# Simulation Configuration (Optional)
# ============================================
export SIM_USERS=25
export SIM_DURATION=30
export SIM_BET_MIN=50
export SIM_BET_MAX=500
export SIM_LOG_LEVEL="INFO"

# ============================================
# Terraform Configuration (Optional)
# ============================================
export TF_VAR_project_id="your-gcp-project-id"
export TF_VAR_region="us-central1"
export TF_VAR_min_instances=1
export TF_VAR_max_instances=10
export TF_VAR_contract_id="CDTUCJ52DABJ3GWL2N5Y5HOEHXA4IA3RUE6DILYFNHWUH4N67EHCWECC"
export TF_VAR_soroban_rpc_url="https://soroban-testnet.stellar.org"

# ============================================
# Instructions
# ============================================
# 1. Copy this file: cp .env.gcp.example .env.gcp
# 2. Fill in your values
# 3. Source the file: source .env.gcp
# 4. Deploy: gcloud builds submit --config gcp/cloudbuild.yaml
